      [ -f "$facture" ] && [ ! -L "$facture" ] && [ "$(stat -c %U "$facture")" = root ] && [ "$(head -c 5 "$facture")" = "%PDF-" ] && [ "$(wc -c < "$facture")" -le 10000000 ] \
        || { echo "Facture refusée : un PDF de root, 10 Mo au plus."; exit 1; }
      install -o root -g root -m 0600 "$facture" "$P/facture.pdf"
    elif [ "$(reglage source)" = mail ]; then
      id "$JARVIS_U" >/dev/null 2>&1 && [ -f "$JARVIS_SRV/google.mjs" ] || { echo "JARVIS n'est pas installé ici (utilisateur $JARVIS_U, $JARVIS_SRV)."; exit 1; }
      q="$(reglage facture_requete) after:$(date -d "$de" +%Y/%m/%d) before:$(date -d "$a + 1 day" +%Y/%m/%d)"
      tmp=$(mktemp); chmod 0600 "$tmp"
      if par_jarvis --requete "$q" --nom "$(reglage facture_nom)" > "$tmp" 2> "$P/facture.erreur" && json_vers_pdf "$tmp" "$P/facture"; then echo "  facture : trouvée dans Gmail ($(wc -c < "$P/facture.pdf") octets)."
      else echo "  facture : pas encore dans Gmail ($(head -c 160 "$P/facture.erreur" | tr '\n' ' '))."; rm -f "$tmp"; echo "Résultat note : attente"; exit 6; fi
      rm -f "$tmp"
    else
      adr_f=$(reglage facture_adresse)
      [[ "$adr_f" =~ ^https?://[A-Za-z0-9._:/?=%\&~+-]+$ ]] || { echo "Réglage « facture_adresse » attendu (https://…)."; exit 1; }
      code=(); [ -n "$(reglage code_mail)" ] && code=(--code-mail "$(reglage code_mail)")
      { cat <<FIN
Essai en lecture seule, selon ta skill « portail ». Adresse : $adr_f
Ouvre cette adresse ; connecte-toi avec l'identifiant du coffre si une page de connexion s'affiche. Va à la liste de tes factures (tes
notes disent où). Télécharge UNE facture : la plus récente émise entre le $(date -d "$de" +%d/%m/%Y) et le $(date -d "$a" +%d/%m/%Y) (sa date
d'émission), selon ta skill (« Télécharger un fichier »). S'il n'y en a pas, ne télécharge rien et dis-le. Ne crée, ne modifie, ne paie rien.
FIN
        [ "$SYSTEMD" = 0 ] && [ -n "${HERMES_BANC_CONSIGNE_EN_PLUS:-}" ] && cat "$HERMES_BANC_CONSIGNE_EN_PLUS"   # banc seulement : la suite d'appels du faux modèle
        echo "Termine par l'étape « Avant de finir » de ta skill (l'attente qui enregistre la session), puis réponds."
      } > "$P/consigne-facture.txt"
      install -d -o root -g root -m 0700 "$P/recu"
      "$0" essai "$adr_f" --consigne-fichier "$P/consigne-facture.txt" --telecharger "$P/recu" "${code[@]}" > "$P/facture-passage.txt" 2>&1
      grep -E '^== Essai|^Fichier (rapporté|écarté)|^Aucun fichier' "$P/facture-passage.txt" | sed 's/^/  /'
      [ -f "$P/recu/telecharge.pdf" ] && mv "$P/recu/telecharge.pdf" "$P/facture.pdf"
      [ -f "$P/facture.pdf" ] || { echo "Arrêt : aucune facture rapportée de l'espace client."; [ -z "$comparer" ] && ndf_retour "$sorte" "$mois" arret "Aucune facture rapportée de l’espace client."; echo "Résultat note : arret"; exit 2; }
    fi
    # 2. son texte (pdf.mjs de JARVIS, puis pdftotext par un utilisateur sans droits)
    id "$JARVIS_U" >/dev/null 2>&1 && [ -f "$JARVIS_SRV/pdf.mjs" ] && par_jarvis --texte-de-l-entree < "$P/facture.pdf" > "$P/facture.txt" 2>/dev/null; chmod 0600 "$P/facture.txt" 2>/dev/null
    command -v pdftotext >/dev/null && { runuser -u nobody -- timeout 60 pdftotext -layout -q - - < "$P/facture.pdf" > "$P/facture.layout.txt" 2>/dev/null; chmod 0600 "$P/facture.layout.txt"; }
    # 3. montant, date, garde-fous, champs (note.py, root, sans réseau)
    hist="$NDF/historique.json"
    python3 -I "$LIB/note.py" preparer --conf "$conf" --dossier "$P" --mois "$mois" --historique "$hist" --sorte "$sorte" --de "$de" --a "$a" $diag > "$P/note.txt" 2>&1; rc=$?
    sed 's/^/  /' "$P/note.txt"
    if [ $rc != 0 ]; then
      [ -z "$comparer" ] && ndf_retour "$sorte" "$mois" arret "Arrêt : $(grep -E '^  - |^Erreur' "$P/note.txt" | sed 's/^  - //' | head -3 | tr '\n' ' ')"
      echo "Résultat note : arret"; exit 2
    fi
    # 4. la dépense vérifiée à blanc (remplie puis annulée)
    adr=$(ndf_reglage ndf_adresse)
    [[ "$adr" =~ ^https?://[A-Za-z0-9._:/?=%\&~+-]+$ ]] || { echo "Réglage « ndf_adresse » attendu (notes.conf)."; exit 1; }
    "$0" brouillon "$adr" --champs-fichier "$P/champs.txt" --justificatif "$P/facture.pdf" --sans-creer > "$P/depense-a-blanc.txt" 2>&1; rc=$?
    propre < "$P/depense-a-blanc.txt" | grep -v '^session_id:' | tail -20
    [ $rc = 0 ] || { echo "Résultat note : echec (dépense à blanc, code $rc)"; exit $rc; }
    # 5. rodage : comparée à la dépense existante (rien n'est posé) ; sinon posée pour sa validation, ou créée seule
    if [ -n "$comparer" ]; then ndf_comparer "$adr" "$P/champs.txt" "$comparer"; exit $?; fi
    python3 -I -c '
import json, os, sys
f, s, m, r = sys.argv[1:5]
try: H = json.load(open(f))
except (OSError, ValueError): H = {}
R = json.load(open(r)); H.setdefault(s, {})[m] = R["montant"]; H.setdefault(s + "_dates", {})[m] = R["date"]
fd = os.open(f + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600); os.write(fd, json.dumps(H).encode()); os.close(fd); os.replace(f + ".tmp", f)
' "$hist" "$sorte" "$mois" "$P/resultat.json"
    ndf_poser "$sorte" "$mois" "$P/champs.txt" "$P/facture.pdf" "$P/resultat.json"; exit $? ;;
  notes-auto)
    # La minuterie de chaque jour (12 h 20) : la note de télétravail le dernier jour du mois, la box à partir du 15 (après le
    # prélèvement), l'abonnement Claude dès que sa facture du mois est dans Gmail. Une tentative par sorte et par mois.
    "$0" teletravail-auto
    aujourdhui=$(TZ=Europe/Paris date +%F); [ "$SYSTEMD" = 0 ] && [ -n "${HERMES_BANC_AUJOURDHUI:-}" ] && aujourdhui=$HERMES_BANC_AUJOURDHUI
    mois=${aujourdhui:0:7}; jour=$((10#${aujourdhui:8:2}))
    install -d -o root -g root -m 0700 "$NDF"; touch "$NDF/tentes.txt"; chmod 0600 "$NDF/tentes.txt"
    exec 8> "$NDF/.verrou-auto"; flock -n 8 || exit 0
    limite_attente && exit 0   # 26/11/2026 : la limite du forfait tient encore : rien tenté avant sa levée
    for s in box claude grok; do
      [ -f "$ETC/note-$s.conf" ] || continue
      grep -qx "$s $mois" "$NDF/tentes.txt" && continue
      grep -qE "^$s $mois " "$NDF/creees.txt" 2>/dev/null && continue
      j=$(sed -n 's/^jour=//p' "$ETC/note-$s.conf" | head -1); j=${j:-1}
      [ "$jour" -ge "$((10#$j))" ] || continue
      out=$(mktemp); chmod 0600 "$out"
      debut_note=$(date +%s)
      "$0" note "$s" --mois "$mois" > "$out" 2>&1; rc=$?
      # 26/11/2026 : la préparation coupée par la limite du forfait (facture, dépense à blanc) avant tout contact avec le portail de
      # notes de frais n'est pas comptée comme tentée : elle repart une fois après la levée. Une création coupée (code 5) est reprise
      # par ndf-auto ; une création en échec (code 4) a déjà son compte rendu (ndf_creer). Coupée après, ou une seconde fois :
      # comptée, et son compte rendu le dit.
      if [ $rc != 0 ] && [ $rc != 2 ] && [ $rc != 3 ] && [ $rc != 4 ] && [ $rc != 5 ] && [ $rc != 6 ]; then
        case "$(limite_verdict "$debut_note")" in
          avant) if limite_planifier note "$s $mois" hermes-portail-teletravail.service; then cat "$out"; rm -f "$out"; continue; fi
                 ndf_retour "$s" "$mois" echec "$LIMITE_DEUX" ;;
          apres) ndf_retour "$s" "$mois" echec "$LIMITE_APRES" ;;
        esac
      fi
      [ $rc = 6 ] || echo "$s $mois" >> "$NDF/tentes.txt"   # facture pas encore arrivée : on réessaie demain
      cat "$out"; rm -f "$out"
    done
    exit 0 ;;
  ndf-auto)
    # La minuterie de 5 minutes : une note posée « à valider » dont il a donné son oui dans JARVIS (sur cette empreinte), créée pour
    # de vrai, une seule fois. Rien sans le portail de notes de frais dans les réglages.
    [ -d "$NDF" ] || exit 0
    exec 9> "$NDF/.verrou"; flock -n 9 || exit 0
    limite_attente && exit 0   # 26/11/2026 : la limite du forfait tient encore : rien tenté avant sa levée
    for d in "$NDF"/*-[0-9][0-9][0-9][0-9]-[0-9][0-9]; do
      [ -d "$d" ] && [ ! -L "$d" ] && [ -f "$d/etat" ] || continue
      b=$(basename "$d"); s=${b%-*-*}; m=${b#"$s"-}
      [[ "$s" =~ ^(teletravail|box|claude|grok)$ ]] || continue
      e=$(cat "$d/etat")
      if [ "$e" = auto_limite ]; then   # 26/11/2026 : une sorte déjà validée une fois, sa création coupée par la limite avant tout contact
        ndf_validee_une_fois "$s" || continue
        echo "== Note $s de $m (sorte déjà validée), coupée par la limite du forfait : reprise de la création"
        echo auto > "$d/etat"; ndf_creer "$s" "$m"; continue
      fi
      [ "$e" = a_valider ] || continue
      emp=$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1]))["empreinte"])' "$d/prepare.json" 2>/dev/null) || continue
      ndf_oui "$s" "$m" "$emp" || continue
      echo "== Son oui dans JARVIS pour la note $s de $m : création réelle"
      ndf_creer "$s" "$m"
    done
    exit 0 ;;
  ndf)
    [ "${1:-etat}" = etat ] || usage
    [ -d "$NDF" ] || { echo "Aucune note préparée."; exit 0; }
    for d in "$NDF"/*-[0-9][0-9][0-9][0-9]-[0-9][0-9]; do [ -f "$d/etat" ] && echo "$(basename "$d") : $(cat "$d/etat")"; done
    [ -s "$NDF/creees.txt" ] && { echo "Créées :"; sed 's/^/  /' "$NDF/creees.txt"; }
    exit 0 ;;
  texte)
    [ $# = 1 ] && [ -f "$1" ] && [ "$(wc -c < "$1")" -le 10000000 ] || { echo "Fichier PDF attendu (10 Mo au plus)."; exit 1; }
    id "$JARVIS_U" >/dev/null 2>&1 && [ -f "$JARVIS_SRV/pdf.mjs" ] || { echo "JARVIS n'est pas installé ici (utilisateur $JARVIS_U, $JARVIS_SRV)."; exit 1; }
    par_jarvis --texte-de-l-entree < "$1"; exit $? ;;
  facture)
    # La facture d'une note de frais arrive par mail : Hermes portail n'a pas de mails. C'est JARVIS qui a l'accès à
    # Gmail ; son code le lit ici, sous l'utilisateur jarvis, en lecture seule, et rend le PDF et son texte à root.
    requete=""; nom='\.pdf$'; vers=""
    while [ $# -gt 0 ]; do case "$1" in
      --requete) requete=${2:-}; shift 2 ;; --nom) nom=${2:-}; shift 2 ;; --vers) vers=${2:-}; shift 2 ;; *) usage ;; esac; done
    [ -n "$requete" ] && [ -n "$vers" ] || usage
    [ -d "$vers" ] && [ "$(stat -c %U "$vers")" = root ] || { echo "Dossier de destination attendu, à root (exemple : /root/facture)."; exit 1; }
    id "$JARVIS_U" >/dev/null 2>&1 && [ -f "$JARVIS_SRV/google.mjs" ] || { echo "JARVIS n'est pas installé ici (utilisateur $JARVIS_U, $JARVIS_SRV)."; exit 1; }
    tmp=$(mktemp); chmod 0600 "$tmp"
    par_jarvis --requete "$requete" --nom "$nom" > "$tmp"; rc=$?
    [ $rc = 0 ] || { rm -f "$tmp"; exit $rc; }
    python3 -I - "$tmp" "$vers" <<'PY'; rc=$?
import base64, json, os, sys
j = json.load(open(sys.argv[1])); d = sys.argv[2]; pdf = base64.b64decode(j['pdf'])
if pdf[:5] != b'%PDF-' or len(pdf) > 5000000: sys.exit('Le fichier reçu n\'est pas un PDF de moins de 5 Mo.')
for nom, contenu in (('facture.pdf', pdf), ('facture.txt', j.get('texte', '').encode())):
    f = os.path.join(d, nom); fd = os.open(f, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600); os.write(fd, contenu); os.close(fd)
print('Facture trouvée : « %s », %d octets, mail du %s.' % (j['nom'][:120], len(pdf), j['dateMail'][:10]))
print('Gardée dans %s/facture.pdf ; son texte (%d caractères) dans %s/facture.txt. À root seul.' % (d, len(j.get('texte', '')), d))
PY
    rm -f "$tmp"; exit $rc ;;
  notes)
    case "${1:-liste}" in
      liste)
        ls "$NOTES"/*.txt >/dev/null 2>&1 || { echo "Aucune note : Hermes n'a encore rien appris d'un portail."; exit 0; }
        for f in "$NOTES"/*.txt; do echo "== $(basename "$f" .txt)"; nl -w2 -s'. ' "$f"; done ;;
      ajouter)
        [ $# = 3 ] || usage; h=$(hote_de "$2") || { echo "Hôte attendu (celui de l'adresse du portail)."; exit 1; }
        note_ajouter "$h" "$3"; case $? in 0) echo "Note gardée pour $h." ;; 2) echo "Déjà connue." ;; *) echo "Note refusée : vide, ou avec une adresse complète ou une adresse mail."; exit 1 ;; esac ;;
      oublier)
        [ $# -ge 2 ] && [ $# -le 3 ] || usage; h=$(hote_de "$2") || { echo "Hôte attendu."; exit 1; }
        [ -f "$NOTES/$h.txt" ] || { echo "Aucune note pour $h."; exit 0; }
        if [ $# = 3 ]; then [[ "$3" =~ ^[0-9]{1,3}$ ]] || usage; sed -i "${3}d" "$NOTES/$h.txt"; echo "Note $3 retirée pour $h."
        else rm -f "$NOTES/$h.txt"; echo "Notes de $h effacées."; fi ;;
      *) usage ;;
    esac ;;
  -h|--help|aide) usage 0 ;;
  *) usage ;;
esac
