# JARVIS OS — traiter les ordres de JARVIS pour les routines d'Hermes (lancé par hermes-ordres.path ; posé par install.sh).
# Exécute la copie root du script (/usr/local/sbin/hermes-ordres → /usr/local/lib/hermes-relance/ordres.py), jamais un fichier du dépôt.
# Un passage lancé à la main part dans une unité à part (hermes-ordre-<routine>, par systemd-run) : il peut durer, les ordres suivants
# n'attendent pas.
[Unit]
Description=Ordres de JARVIS pour les routines d'Hermes : lecture, validation, exécution

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/hermes-ordres
TimeoutStartSec=300
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
