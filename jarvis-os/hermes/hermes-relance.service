# JARVIS OS — relance automatique après la limite du forfait Claude (posé par install.sh ; lancé par hermes-relance.timer).
# Exécute la copie root du script (/usr/local/sbin/hermes-relance → /usr/local/lib/hermes-relance/limite.py), jamais un fichier du dépôt.
[Unit]
Description=Relance de ce que la limite du forfait Claude a coupé (routines d'Hermes, tâches d'hermes-portail)
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/hermes-relance
StateDirectory=hermes-relance
StateDirectoryMode=0700
TimeoutStartSec=300
# JARVIS d'abord : la lecture d'usage (Hermes et la sonde de Claude Code, quelques secondes) passe après lui
Nice=10
CPUWeight=20
IOWeight=20
OOMScoreAdjust=700
MemoryMax=600M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
